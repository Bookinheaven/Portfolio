# Destination email where visitor notifications will be sent
NOTIFICATION_EMAIL=tanviksriram@gmail.com

# Verified sender email in your Brevo account (e.g. your login/verified email)
# Format can be: tanviksriram@gmail.com or Portfolio Alerts <tanviksriram@gmail.com>
NOTIFICATION_FROM_EMAIL=Portfolio Alerts <tanviksriram@gmail.com>
